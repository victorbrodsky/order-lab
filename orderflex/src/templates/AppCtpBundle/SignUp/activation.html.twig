{#Account activation page for CTP sites (ctp, tma, cohortg, regulatoryt, spore).
  The CTP base renders only block content_ctp and loads no form javascript,
  so the shared activation form is rendered here with the user form scripts.#}
{% extends "AppCtpBundle/Default/base.html.twig" %}

{% block title %}
    Registration Activation for {{ sitenamefull }}
{% endblock %}

{% block content_ctp %}
    <input type="hidden" id="baseurl" value="{{app.request.host}}{{app.request.getBaseURL()}}" />
    <input type="hidden" id="authuser_id" value="{{ app.user ? app.user.getId() : '' }}" />
    <input type="hidden" id="formcycle" value="{{ cycle }}" />

    <div class="mx-auto max-w-5xl px-4 py-8 ctp-activation">
        {% for flashMessage in app.flashes('notice') %}
            <div class="flash-notice" align="center">{{ flashMessage|raw }}</div>
        {% endfor %}
        {% for flashMessage in app.flashes('warning') %}
            <p class="alert alert-danger center-block" align="middle">{{ flashMessage|raw }}</p>
        {% endfor %}

        {% include 'AppUserdirectoryBundle/SignUp/activation_content.html.twig' %}
    </div>
{% endblock %}

{% block additionalcss %}
    {#The CTP base loads Tailwind (its reset removes input borders/backgrounds) and omits bootstrap.min.css
      to keep the CTP header intact, so the Bootstrap classes used by the form macros (row, col-xs-6,
      form-control, btn) are styled here, scoped to the activation form only.#}
    <style>
        .ctp-activation { font-size: 14px; line-height: 1.42857143; color: #333; }
        .ctp-activation h3 { font-size: 24px; font-weight: 500; color: #31708f; text-align: center; margin: 10px 0; }
        .ctp-activation hr { margin: 10px 0 20px 0; border: 0; border-top: 1px solid #eee; }
        .ctp-activation .row { display: flex; flex-wrap: wrap; align-items: center; margin: 0 -15px 8px -15px; }
        .ctp-activation .row > ul { width: 100%; padding: 0 15px; color: #a94442; text-align: center; }
        .ctp-activation .col-xs-6 { width: 50%; padding: 0 15px; }
        .ctp-activation .col-xs-6[align="right"] { text-align: right; font-weight: bold; }
        .ctp-activation label { font-weight: bold; margin: 0; }
        .ctp-activation .form-control {
            display: block; width: 100%; height: 34px; padding: 6px 12px;
            font-size: 14px; line-height: 1.42857143; color: #555;
            background-color: #fff; border: 1px solid #ccc; border-radius: 4px;
            box-shadow: inset 0 1px 1px rgba(0,0,0,.075);
        }
        .ctp-activation .form-control:focus { border-color: #66afe9; outline: 0; box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102,175,233,.6); }
        .ctp-activation .form-control[disabled], .ctp-activation .form-control[readonly] { background-color: #eee; }
        .ctp-activation p { margin: 12px 0; }
        .ctp-activation .text-center { text-align: center; }
        .ctp-activation .btn {
            display: inline-block; padding: 6px 12px; font-size: 14px; line-height: 1.42857143;
            border: 1px solid transparent; border-radius: 4px; cursor: pointer;
        }
        .ctp-activation .btn-primary { color: #fff; background-color: #337ab7; border-color: #2e6da4; }
        .ctp-activation .btn-primary:hover { background-color: #286090; border-color: #204d74; }
    </style>
{% endblock %}

