{% extends "AppTranslationalResearchBundle/Default/base.html.twig" %}
{% import "AppOrderformBundle/Default/formmacros.html.twig" as formmacros %}
{% import "AppTranslationalResearchBundle/Default/transres.html.twig" as transres %}

{% block title %}
    {{ title }}
{% endblock %}

{% block content %}

    <h4 class="text-info" align="center">
        {{ title }}
    </h4>

    <br>

    {{ form_start(form) }}

        {{ form_errors(form) }}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">
                    {% if inquiryType is defined and inquiryType == 'external' %}
                        External Collaboration Project Inquiry
                    {% else %}
                        Project's Initial Inquiry
                    {% endif %}
                </h4>
            </div>
            <div class="panel-body">

                {#{{ formmacros.field(form.createDate) }}#}
                {% if cycle != 'new' %}
                    {{ formmacros.simplefield(
                        "Submission Date:",
                        project.createDate ? project.createDate|date('m/d/Y',false) : '',
                        "input", "disabled")
                    }}
                {% endif %}

                {% if form.title is defined %}
                    {{ formmacros.field(form.title) }}
                {% endif %}
                {% if form.inquiryPiName is defined %}
                    {{ formmacros.field(form.inquiryPiName) }}
                {% endif %}
                {% if form.inquiryOrgName is defined %}
                    {{ formmacros.field(form.inquiryOrgName) }}
                {% endif %}
                {% if form.inquiryPhone is defined %}
                    {{ formmacros.field(form.inquiryPhone) }}
                {% endif %}
                {% if form.inquiryContactName is defined %}
                    {{ formmacros.field(form.inquiryContactName) }}
                {% endif %}
                {% if form.inquiryContactEmail is defined %}
                    {{ formmacros.field(form.inquiryContactEmail) }}
                {% endif %}
                {{ formmacros.field(form.description) }}
                {{ formmacros.field(form.inquiryPlanSummary) }}
                {% if form.inquiryFundingSource is defined %}
                    {{ formmacros.field(form.inquiryFundingSource) }}
                {% endif %}

            </div>
        </div>

        {#{{ transres.projectInfo(form,project,cycle) }}#}

        <p>
            {% if form.saveAsDraft is defined %}
                {{ form_widget(form.saveAsDraft) }}
            {% endif %}
            {% if form.submitIrbReview is defined %}
                {{ form_widget(form.submitIrbReview) }}
            {% endif %}
            {% if form.updateProject is defined %}
                {{ form_widget(form.updateProject) }}
            {% endif %}
            <a class="btn btn-default"
               href="{{ path(translationalresearch_sitename~'_project_show',{ 'id': project.id }) }}">Cancel</a>

        </p>

    {{ form_end(form) }}

{% endblock %}
