{% extends "AppVacReqBundle/Default/base.html.twig" %}
{% import "AppVacReqBundle/Default/vacreqmacros.html.twig" as vacreqmacros %}

{% block title %}
    Details for {{ subjectUser.getUserNameStr() }}
{% endblock %}

{% block content %}

    {% set inaccuracyMessage = vacreq_util.getInaccuracyMessage() %}

    <h4 class="text-info" align="center">
        Away Request History: {{ subjectUser.getUserNameStr() }}
    </h4>

    <br>

    <table class="records_list table table-hover table-condensed text-left table-bordered sortable">
        <thead>
            <tr>
                <th>Academic Year</th>
                <th>Carried Over Vacation Days From Previous Year</th>
                <th title="Total accrued vacation days for this academic year taking into consideration employment period start/end dates">Accrued Days</th>
                <th title="Carried Over Days From Previous Year + Accrued Days">Total</th>
                <th title="Total approved Vacation days">Vacation Days Taken</th>
                <th>Remaining Vacation Days</th>
                <th>Carried Over Vacation Days To Next Year</th>
            </tr>
        </thead>
        <tbody>
            {#rows sorted from the earliest year on top to the latest year on bottom#}
            {% for yearRange in yearRanges|reverse %}

                {% set backgroundColor = yearRangesColor[loop.index0 % yearRangesColor|length] %}

                {% set vacationDaysRes = vacreq_util.getApprovedTotalDaysAcademicYear(subjectUser,'vacation',yearRange,"approved") %}
                {% set vacationDays = vacationDaysRes['numberOfDays'] %}
                {% set vacationAccurate = vacationDaysRes['accurate'] %}

                {% set carryOverDaysPrevYear = vacreq_util.getUserCarryOverDays(subjectUser,yearRange) %}

                {% set accruedDays = vacreq_util.getTotalAccruedDays(subjectUser,yearRange) %}
                {% set totalDays = carryOverDaysPrevYear + accruedDays %}

                {% set yearParts = yearRange|split('-') %}
                {% set nextYearRange = (yearParts[0] + 1) ~ '-' ~ (yearParts[1] + 1) %}
                {% set carryOverDaysNextYear = vacreq_util.getUserCarryOverDays(subjectUser,nextYearRange) %}

                {% set totalRemainingDaysRes =
                    vacreq_util.totalVacationRemainingDays(
                        subjectUser,
                        null,
                        vacationDays,
                        carryOverDaysNextYear,
                        carryOverDaysPrevYear,
                        yearRange
                    )
                %}

                <tr>
                    <td style="background-color: {{ backgroundColor }}">
                        {{ yearRange }}
                    </td>
                    <td>
                        {{ carryOverDaysPrevYear }}
                    </td>
                    <td>
                        {{ accruedDays }}
                    </td>
                    <td>
                        {{ totalDays }}
                    </td>
                    <td>
                        {{ vacationDays }}
                        {% if not vacationAccurate %}
                            <span data-toggle="tooltip" title="{{ inaccuracyMessage }}">*</span>
                        {% endif %}
                    </td>
                    <td>
                        {{ totalRemainingDaysRes['numberOfDays'] }}
                        {% if not totalRemainingDaysRes['accurate'] %}
                            <span data-toggle="tooltip" title="{{ inaccuracyMessage }}">*</span>
                        {% endif %}
                    </td>
                    <td>
                        {{ carryOverDaysNextYear }}
                    </td>
                </tr>

            {% endfor %}
        </tbody>
    </table>

{% endblock %}
