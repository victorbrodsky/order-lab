{% extends "AppWikiportalBundle/Default/base.html.twig" %}
{% import "AppUserdirectoryBundle/Default/usermacros.html.twig" as usermacros %}

{% block title %}
    {% if page %}Edit{% else %}New{% endif %} Wiki Page
{% endblock %}

{% block content %}

    <div class="text-left">

    <h4 class="text-info">
        {% if page %}Edit{% else %}New{% endif %} Wiki Page
    </h4>

    <form method="post"
          action="{% if page %}{{ path('wikiportal_page_edit', {'id': page.id}) }}{% else %}{{ path('wikiportal_page_new') }}{% endif %}">

        <div class="form-group">
            <label for="wiki-page-title">Title</label>
            <input type="text" class="form-control" id="wiki-page-title" name="title"
                   value="{% if page %}{{ page.title }}{% endif %}" required />
        </div>

        <div class="form-group">
            <label for="wiki-page-slug">Slug (URL)</label>
            <input type="text" class="form-control" id="wiki-page-slug" name="slug"
                   value="{% if page %}{{ page.slug }}{% endif %}"
                   placeholder="auto-generated from title if empty" />
        </div>

        <div class="form-group">
            <label for="wiki-page-parent">Parent Page</label>
            <select class="form-control" id="wiki-page-parent" name="parent">
                <option value="">(none - top level)</option>
                {% for candidate in parentCandidates %}
                    <option value="{{ candidate.id }}"
                        {% if (page and page.parent and page.parent.id == candidate.id)
                              or (presetParent is defined and presetParent and presetParent.id == candidate.id) %}selected{% endif %}>
                        {{ candidate.fullPath }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="wiki-page-sortorder">Sort Order</label>
            <input type="number" class="form-control" id="wiki-page-sortorder" name="sortOrder"
                   value="{% if page %}{{ page.sortOrder }}{% endif %}"
                   placeholder="optional ordering among sibling pages" />
        </div>

        <div class="form-group">
            <label>
                <input type="checkbox" name="isHomepage" value="1"
                       {% if page and page.isHomepage %}checked{% endif %} />
                Home page (rendered at {{ path('wikiportal_home') }})
            </label>
            <p class="help-block">Only allowed for top-level pages; setting this un-flags the previous home page.</p>
        </div>

        <div class="form-group">
            <label>Content</label>
            {{ usermacros.tiptapField('wiki-page-body', page ? page.body : '', {
                'uploadUrl': oneup_uploader_endpoint('wikiportal_gallery'),
                'downloadUrl': path('wikiportal_file_download', {'id': 0})|slice(0, -2),
                'viewUrl': path('wikiportal_file_view', {'id': 0})|slice(0, -2),
                'userid': app.user.id,
                'authuserid': app.user.id,
                'sitename': 'wikiportal',
                'documenttype': 'Wiki Page Attachment',
                'name': 'body'
            }) }}
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-default" href="{{ path('wikiportal_pages') }}">Cancel</a>
    </form>

    </div>

{% endblock %}
