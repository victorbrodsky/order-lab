{% extends "AppWikiportalBundle/Default/base.html.twig" %}

{% block title %}
    {{ page.title }}
{% endblock %}

{% block additionalcss %}
    <style>
        .wiki-page-body img {
            max-width: 100%;
            height: auto;
        }
    </style>
{% endblock %}

{% block content %}

    <div class="pull-right">
        {% if is_granted('ROLE_WIKIPORTAL_EDITOR') %}
            <a class="btn btn-default" href="{{ path('wikiportal_page_edit', {'id': page.id}) }}">
                <span class="glyphicon glyphicon-pencil"></span> Edit
            </a>
        {% endif %}
        <a class="btn btn-default" href="{{ path('wikiportal_pages') }}">All Pages</a>
    </div>

    <h4 class="text-info">
        {{ page.title }}
    </h4>

    <div class="well well-sm text-muted">
        {% if page.updateuser %}
            Last updated by {{ page.updateuser.getUserNameShortStr() }}
        {% elseif page.creator %}
            Created by {{ page.creator.getUserNameShortStr() }}
        {% endif %}
        {% if page.updatedate %}
            on {{ page.updatedate|date('m/d/Y H:i') }}
        {% endif %}
    </div>

    <div class="wiki-page-body">
        {{ page.body|raw }}
    </div>

{% endblock %}
