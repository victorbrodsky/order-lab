{# Renders one level of the page tree; includes itself recursively for children.
   Expects: 'pages' (array of WikiPage), 'current' (WikiPage or null) #}

<ul class="wiki-page-tree-level">
    {% for p in pages %}
        <li>
            <a href="{{ path('wikiportal_page_show', {'path': p.fullPath}) }}"
               class="wiki-page-link{% if current and p.id == current.id %} active{% endif %}">
                {{ p.title }}
            </a>
            {% if p.children|length > 0 %}
                {% include "AppWikiportalBundle/Default/page-tree-level.html.twig"
                    with {'pages': p.children, 'current': current} only %}
            {% endif %}
        </li>
    {% endfor %}
</ul>
