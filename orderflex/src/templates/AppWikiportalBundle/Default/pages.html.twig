{% extends "AppWikiportalBundle/Default/base.html.twig" %}

{% block title %}
    Wiki Pages
{% endblock %}

{% block content %}

    <h4 class="text-info" align="center">
        Wiki Pages
    </h4>

    {% if is_granted('ROLE_WIKIPORTAL_EDITOR') %}
        <p>
            <a class="btn btn-default" href="{{ path('wikiportal_page_new') }}">
                <span class="glyphicon glyphicon-plus"></span> New Wiki Page
            </a>
        </p>
    {% endif %}

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Slug</th>
                <th>Updated</th>
                <th>Author</th>
                {% if is_granted('ROLE_WIKIPORTAL_EDITOR') %}
                    <th>Actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for page in pages %}
                <tr>
                    <td>
                        <a href="{{ path('wikiportal_page_show', {'slug': page.slug}) }}">{{ page.title }}</a>
                    </td>
                    <td>{{ page.slug }}</td>
                    <td>{% if page.updatedate %}{{ page.updatedate|date('m/d/Y H:i') }}{% endif %}</td>
                    <td>{% if page.updateuser %}{{ page.updateuser.getUserNameShortStr() }}{% elseif page.creator %}{{ page.creator.getUserNameShortStr() }}{% endif %}</td>
                    {% if is_granted('ROLE_WIKIPORTAL_EDITOR') %}
                        <td>
                            <a class="btn btn-xs btn-default" href="{{ path('wikiportal_page_edit', {'id': page.id}) }}">Edit</a>
                            {% if is_granted('ROLE_WIKIPORTAL_ADMIN') %}
                                <form method="post" action="{{ path('wikiportal_page_delete', {'id': page.id}) }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this wiki page?');">
                                    <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted">No wiki pages yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
